{
  "manifest_version": 3,
  "name": "Clear Cache",
  "version": "1.4",
  "description": "پاک کردن کش و تاریخچه‌ی مرورگر و مسدود کردن پنجره‌های تبلیغاتی",
  "minimum_chrome_version": "120",
  "permissions": [
    "browsingData",
    "history",
    "activeTab",
    "scripting",
    "webNavigation",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clear Cache",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      }
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/vazirmatn.woff2"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
