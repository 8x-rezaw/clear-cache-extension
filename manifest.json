{
  "manifest_version": 3,
  "name": "Clear Cache",
  "version": "1.7.4",
  "description": "پاک کردن کش و تاریخچه‌ی مرورگر و مسدود کردن تبلیغات و پنجره‌های مزاحم",
  "minimum_chrome_version": "120",
  "permissions": [
    "browsingData",
    "history",
    "activeTab",
    "scripting",
    "webNavigation",
    "storage",
    "declarativeNetRequest",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads",
        "enabled": true,
        "path": "rules/ads.json"
      }
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clear Cache",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      }
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/vazirmatn.woff2"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    },
    {
      "resources": [
        "blocked.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
